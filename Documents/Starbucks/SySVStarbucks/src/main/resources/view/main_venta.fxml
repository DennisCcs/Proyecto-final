<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.sysvstarbucks.controller.VentaController"
      spacing="14" style="-fx-background-color: #f5f4f0; -fx-padding: 20 24 20 24;">
    <VBox spacing="5" style="-fx-background-color: white; -fx-padding: 16; -fx-background-radius: 8;">
        <Label text="Nueva venta" style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: #1e3932;" />
        <Label text="Selecciona productos, personaliza cada opción y revisa el carrito antes de emitir la boleta."
               style="-fx-font-size: 13px; -fx-text-fill: #5b625f;" />
    </VBox>

    <GridPane hgap="12" vgap="10" style="-fx-background-color: white; -fx-padding: 16; -fx-background-radius: 8;">
        <Label text="Producto" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <ComboBox fx:id="cmbProducto" promptText="Selecciona un producto" maxWidth="Infinity"
                  GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="0" />
        <Label text="Tamaño (obligatorio)" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <ComboBox fx:id="cmbPresentacion" promptText="Selecciona" maxWidth="Infinity"
                  GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="1" />

        <Label fx:id="lblOpcion1" text="Personaliza tu producto (opcional)" wrapText="true"
               GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <VBox spacing="5" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="2">
            <ListView fx:id="lstPersonalizaciones" prefHeight="88" visible="false" managed="false">
                <placeholder><Label text="Este producto no tiene personalizaciones registradas." /></placeholder>
            </ListView>
            <ComboBox fx:id="cmbOpcion1" promptText="Selecciona una opción" maxWidth="Infinity"
                      visible="false" managed="false" />
        </VBox>
        <Label text="Cantidad" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="txtCantidad" text="1" promptText="1" prefWidth="90"
                   GridPane.columnIndex="1" GridPane.rowIndex="3" />
        <Label fx:id="lblPrecio" text="Precio: S/ 0.00" GridPane.columnIndex="2" GridPane.rowIndex="3" />
        <Button text="Agregar al carrito" onAction="#agregarAlCarrito"
                style="-fx-background-color: #00704a; -fx-text-fill: white; -fx-font-weight: bold;"
                GridPane.columnIndex="3" GridPane.rowIndex="3" />

        <columnConstraints>
            <ColumnConstraints minWidth="115" prefWidth="150" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="160" prefWidth="260" />
            <ColumnConstraints minWidth="135" prefWidth="170" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="160" prefWidth="260" />
        </columnConstraints>
    </GridPane>

    <HBox alignment="TOP_LEFT" spacing="10">
        <Label text="Cliente (opcional)" minWidth="130" />
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <HBox spacing="8">
                <TextField fx:id="txtDocumentoCliente" promptText="Escribe DNI o RUC para buscar" prefWidth="260" />
                <TextField fx:id="txtNombreCliente" promptText="Nombre del cliente seleccionado" HBox.hgrow="ALWAYS" />
            </HBox>
            <ListView fx:id="lstClientesSugeridos" prefHeight="112" maxHeight="112" visible="false" managed="false">
                <placeholder><Label text="No hay clientes que coincidan con el documento." /></placeholder>
            </ListView>
        </VBox>
    </HBox>

    <TableView fx:id="tablaCarrito" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colProducto" text="Producto" prefWidth="180" />
            <TableColumn fx:id="colDetalle" text="Tamaño y personalizaciones" prefWidth="330" />
            <TableColumn fx:id="colCantidad" text="Cant." prefWidth="70" />
            <TableColumn fx:id="colPrecio" text="P. unitario (S/)" prefWidth="130" />
            <TableColumn fx:id="colSubtotal" text="Subtotal (S/)" prefWidth="130" />
        </columns>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Button text="Quitar seleccionado" onAction="#quitarDelCarrito" />
        <Button text="Vaciar carrito" onAction="#vaciarCarrito" />
        <Label fx:id="lblMensaje" HBox.hgrow="ALWAYS" wrapText="true" />
        <VBox alignment="CENTER_RIGHT" spacing="4" style="-fx-background-color: white; -fx-padding: 12 18 12 18; -fx-background-radius: 8;">
            <HBox spacing="24"><Label text="Neto" /><Label fx:id="lblNeto" text="S/ 0.00" /></HBox>
            <HBox spacing="24"><Label text="IGV (18%)" /><Label fx:id="lblIgv" text="S/ 0.00" /></HBox>
            <HBox spacing="24"><Label text="Total" style="-fx-font-weight: bold;" />
                <Label fx:id="lblTotal" text="S/ 0.00" style="-fx-font-weight: bold; -fx-text-fill: #006241;" />
            </HBox>
        </VBox>
        <Button text="Registrar venta y generar boleta" onAction="#continuarBoleta"
                style="-fx-background-color: #1e3932; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 18 12 18;" />
    </HBox>
    <padding><Insets top="0" right="0" bottom="0" left="0" /></padding>
</VBox>
