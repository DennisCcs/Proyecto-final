<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.sysvstarbucks.controller.HistorialComprasController"
      spacing="14" style="-fx-background-color: #f5f4f0; -fx-padding: 20 24 20 24;">
    <VBox spacing="5" style="-fx-background-color: white; -fx-padding: 16; -fx-background-radius: 8;">
        <Label text="Historial de compras" style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: #1e3932;" />
        <Label text="Revisa las compras de insumos registradas y consulta sus paquetes y totales."
               style="-fx-font-size: 13px; -fx-text-fill: #5b625f;" />
    </VBox>

    <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: white; -fx-padding: 12; -fx-background-radius: 8;">
        <Label text="Buscar" />
        <TextField fx:id="txtBuscar" promptText="Código de compra o proveedor" HBox.hgrow="ALWAYS" />
        <Button text="Limpiar búsqueda" onAction="#limpiarBusqueda" />
    </HBox>

    <TableView fx:id="tablaCompras" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCodigo" text="Compra" prefWidth="95" />
            <TableColumn fx:id="colProveedor" text="Proveedor" prefWidth="270" />
            <TableColumn fx:id="colPaquetes" text="Paquetes" prefWidth="100" />
            <TableColumn fx:id="colLineas" text="Insumos distintos" prefWidth="145" />
            <TableColumn fx:id="colNeto" text="Neto (S/)" prefWidth="115" />
            <TableColumn fx:id="colIgv" text="IGV (S/)" prefWidth="105" />
            <TableColumn fx:id="colTotal" text="Total (S/)" prefWidth="120" />
        </columns>
        <placeholder><Label text="No hay compras que coincidan con la búsqueda." /></placeholder>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Button fx:id="btnVerDetalle" text="Ver detalle de compra" onAction="#verDetalle" disable="true"
                style="-fx-background-color: #006241; -fx-text-fill: white; -fx-font-weight: bold;" />
        <Label fx:id="lblEstado" HBox.hgrow="ALWAYS" wrapText="true" style="-fx-text-fill: #795500;" />
        <VBox alignment="CENTER_RIGHT" spacing="4"
              style="-fx-background-color: white; -fx-padding: 12 18 12 18; -fx-background-radius: 8;">
            <HBox spacing="20"><Label text="Compras" /><Label fx:id="lblCantidad" text="0" /></HBox>
            <HBox spacing="20"><Label text="Total comprado" style="-fx-font-weight: bold;" />
                <Label fx:id="lblTotalComprado" text="S/ 0.00" style="-fx-font-weight: bold; -fx-text-fill: #006241;" />
            </HBox>
        </VBox>
    </HBox>
    <padding><Insets top="0" right="0" bottom="0" left="0" /></padding>
</VBox>

