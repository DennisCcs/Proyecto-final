<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.sysvstarbucks.controller.ProveedorController"
      spacing="14" style="-fx-background-color: #f5f4f0; -fx-padding: 20 24 20 24;">
    <VBox spacing="5" style="-fx-background-color: white; -fx-padding: 16; -fx-background-radius: 8;">
        <Label text="Gestión de proveedores" style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: #1e3932;" />
        <Label text="Administra las personas o empresas que suministran insumos al establecimiento."
               style="-fx-font-size: 13px; -fx-text-fill: #5b625f;" />
    </VBox>

    <HBox alignment="CENTER_LEFT" spacing="8"
          style="-fx-background-color: #fff8e1; -fx-padding: 10 14 10 14; -fx-background-radius: 6;">
        <Label text="PROVEEDORES PARA COMPRAS" style="-fx-font-weight: bold; -fx-text-fill: #795500;" />
        <Label text="Asigna insumos a cada proveedor para que sus paquetes aparezcan en Nueva compra."
               style="-fx-text-fill: #795500;" />
    </HBox>

    <GridPane hgap="12" vgap="10" style="-fx-background-color: white; -fx-padding: 16; -fx-background-radius: 8;">
        <Label text="Tipo de documento" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <ComboBox fx:id="cmbTipoDocumento" promptText="DNI / RUC" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        <Label text="Número de documento" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <TextField fx:id="txtDocumento" promptText="DNI o RUC" GridPane.columnIndex="3" GridPane.rowIndex="0" />
        <Label text="Nombre o razón social" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtNombres" promptText="Nombre del proveedor o empresa" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="1" />
        <Label text="Celular (opcional)" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="txtCelular" promptText="Celular" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        <Label text="Correo (opcional)" GridPane.columnIndex="2" GridPane.rowIndex="2" />
        <TextField fx:id="txtCorreo" promptText="correo@ejemplo.com" GridPane.columnIndex="3" GridPane.rowIndex="2" />
        <Label text="Dirección (opcional)" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextArea fx:id="txtDireccion" promptText="Dirección del proveedor" prefRowCount="2" wrapText="true"
                  GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="3" />
        <HBox spacing="8" alignment="CENTER_LEFT" GridPane.columnIndex="0" GridPane.columnSpan="4" GridPane.rowIndex="4">
            <Button fx:id="btnGuardar" text="Agregar proveedor" onAction="#guardarProveedor"
                    style="-fx-background-color: #00704a; -fx-text-fill: white; -fx-font-weight: bold;" />
            <Button text="Limpiar" onAction="#limpiarFormulario" />
            <Button text="Eliminar seleccionado" onAction="#eliminarProveedor" />
        </HBox>
        <Label fx:id="lblMensaje" wrapText="true" GridPane.columnIndex="0" GridPane.columnSpan="4" GridPane.rowIndex="5" />
        <columnConstraints>
            <ColumnConstraints minWidth="145" prefWidth="175" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="170" prefWidth="255" />
            <ColumnConstraints minWidth="150" prefWidth="185" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="190" prefWidth="280" />
        </columnConstraints>
    </GridPane>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Buscar:" />
        <TextField fx:id="txtBuscar" promptText="Documento, nombre o correo" prefWidth="340" />
        <Label fx:id="lblConteo" HBox.hgrow="ALWAYS" />
    </HBox>

    <TableView fx:id="tablaProveedores" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colTipo" text="Tipo" prefWidth="90" />
            <TableColumn fx:id="colDocumento" text="Documento" prefWidth="130" />
            <TableColumn fx:id="colNombres" text="Nombre / razón social" prefWidth="250" />
            <TableColumn fx:id="colCelular" text="Celular" prefWidth="120" />
            <TableColumn fx:id="colCorreo" text="Correo" prefWidth="190" />
            <TableColumn fx:id="colDireccion" text="Dirección" prefWidth="250" />
        </columns>
        <placeholder><Label text="No hay proveedores que coincidan con la búsqueda." /></placeholder>
    </TableView>
    <padding><Insets top="0" right="0" bottom="0" left="0" /></padding>
</VBox>


