<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.sysvstarbucks.controller.UsuarioController"
      spacing="14" style="-fx-background-color: #f5f4f0; -fx-padding: 20 24 20 24;">
    <VBox spacing="5" style="-fx-background-color: white; -fx-padding: 16; -fx-background-radius: 8;">
        <Label text="Gestión de usuarios" style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: #1e3932;" />
        <Label text="Crea las cuentas del personal y asigna el perfil de administrador o vendedor."
               style="-fx-font-size: 13px; -fx-text-fill: #5b625f;" />
    </VBox>

    <GridPane hgap="12" vgap="10" style="-fx-background-color: white; -fx-padding: 16; -fx-background-radius: 8;">
        <Label text="Nombre de usuario" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtUsuario" promptText="Ej.: barista01" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        <Label text="Contraseña" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <PasswordField fx:id="txtClave" promptText="Mínimo 8 caracteres" GridPane.columnIndex="3" GridPane.rowIndex="0" />
        <Label text="Perfil" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <ComboBox fx:id="cmbPerfil" promptText="Administrador / Vendedor" maxWidth="Infinity"
                  GridPane.columnIndex="1" GridPane.rowIndex="1" />
        <Label text="Estado" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <ComboBox fx:id="cmbEstado" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="1" />
        <HBox spacing="8" alignment="CENTER_LEFT" GridPane.columnIndex="0" GridPane.columnSpan="4" GridPane.rowIndex="2">
            <Button fx:id="btnGuardar" text="Agregar usuario" onAction="#guardarUsuario"
                    style="-fx-background-color: #00704a; -fx-text-fill: white; -fx-font-weight: bold;" />
            <Button text="Limpiar" onAction="#limpiarFormulario" />
            <Button text="Eliminar seleccionado" onAction="#eliminarUsuario" />
        </HBox>
        <Label fx:id="lblMensaje" wrapText="true" GridPane.columnIndex="0" GridPane.columnSpan="4" GridPane.rowIndex="3" />
        <columnConstraints>
            <ColumnConstraints minWidth="145" prefWidth="175" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="170" prefWidth="255" />
            <ColumnConstraints minWidth="150" prefWidth="185" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="190" prefWidth="280" />
        </columnConstraints>
    </GridPane>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Buscar:" />
        <TextField fx:id="txtBuscar" promptText="Usuario, perfil o estado" prefWidth="340" />
        <Label fx:id="lblConteo" HBox.hgrow="ALWAYS" />
    </HBox>

    <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="90" />
            <TableColumn fx:id="colUsuario" text="Usuario" prefWidth="250" />
            <TableColumn fx:id="colPerfil" text="Perfil" prefWidth="220" />
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="150" />
        </columns>
        <placeholder><Label text="Todavía no hay usuarios registrados." /></placeholder>
    </TableView>
    <padding><Insets top="0" right="0" bottom="0" left="0" /></padding>
</VBox>


