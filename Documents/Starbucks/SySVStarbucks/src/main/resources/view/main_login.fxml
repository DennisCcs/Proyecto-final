<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<StackPane fx:id="root" xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="pe.edu.upeu.sysvstarbucks.controller.LoginController"
           style="-fx-background-color: #eef2ef; -fx-padding: 28;">
    <HBox maxWidth="960" maxHeight="580" style="-fx-background-color: white; -fx-background-radius: 18;">
        <VBox alignment="CENTER_LEFT" spacing="24" prefWidth="390" minWidth="350"
              style="-fx-background-color: linear-gradient(to bottom right, #006241, #1e3932); -fx-padding: 42; -fx-background-radius: 18 0 0 18;">
            <VBox spacing="6">
                <Label text="STARBUCKS" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #d4e9df; -fx-letter-spacing: 3px;" />
                <Label text="Sistema de ventas" style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: white;" />
            </VBox>
            <StackPane prefWidth="120" prefHeight="120" maxWidth="120" maxHeight="120">
                <Circle radius="58" fill="#ffffff" opacity="0.14" />
                <Circle radius="45" fill="#ffffff" opacity="0.16" />
                <Label text="☕" style="-fx-font-size: 58px;" />
            </StackPane>
            <VBox spacing="10">
                <Label text="Cada atención empieza con un buen acceso."
                       wrapText="true" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;" />
                <Label text="Ingresa para gestionar ventas, productos y compras de la tienda."
                       wrapText="true" style="-fx-font-size: 14px; -fx-text-fill: #d4e9df;" />
            </VBox>
            <Label text="PLATAFORMA DE GESTIÓN · STARBUCKS"
                   style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #b8d8c8; -fx-letter-spacing: 1px;" />
        </VBox>

        <VBox alignment="CENTER_LEFT" spacing="18" prefWidth="500" minWidth="440"
              style="-fx-padding: 48 52 38 52;">
            <VBox spacing="7">
                <Label fx:id="lblTitulo" text="Bienvenido"
                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1e3932;" />
                <Label fx:id="lblSubtitulo" text="Ingresa con tu cuenta de personal para continuar."
                       wrapText="true" style="-fx-font-size: 13px; -fx-text-fill: #69716d;" />
            </VBox>

            <VBox spacing="7">
                <Label fx:id="lblUsuario" text="Usuario" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #39443e;" />
                <HBox alignment="CENTER_LEFT" spacing="10"
                      style="-fx-border-color: #d9dfdb; -fx-border-radius: 7; -fx-background-radius: 7; -fx-padding: 0 12 0 12;">
                    <ImageView fitWidth="18" fitHeight="18" preserveRatio="true">
                        <image><Image url="@../img/user.png" /></image>
                    </ImageView>
                    <TextField fx:id="txtUsuario" promptText="Escribe tu usuario" HBox.hgrow="ALWAYS"
                               style="-fx-background-color: transparent; -fx-padding: 12 0 12 0;" />
                </HBox>
            </VBox>

            <VBox spacing="7">
                <Label fx:id="lblClave" text="Contraseña" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #39443e;" />
                <HBox alignment="CENTER_LEFT" spacing="10"
                      style="-fx-border-color: #d9dfdb; -fx-border-radius: 7; -fx-background-radius: 7; -fx-padding: 0 12 0 12;">
                    <ImageView fitWidth="18" fitHeight="18" preserveRatio="true">
                        <image><Image url="@../img/pass.png" /></image>
                    </ImageView>
                    <PasswordField fx:id="txtClave" promptText="Escribe tu contraseña" HBox.hgrow="ALWAYS"
                                   onAction="#iniciarSesion"
                                   style="-fx-background-color: transparent; -fx-padding: 12 0 12 0;" />
                </HBox>
            </VBox>

            <Label fx:id="lblMensaje" minHeight="20" wrapText="true"
                   style="-fx-font-size: 12px; -fx-text-fill: #69716d;" />
            <Button fx:id="btnIngresar" text="Iniciar sesión" maxWidth="Infinity" onAction="#iniciarSesion"
                    style="-fx-background-color: #00704a; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 13 18 13 18; -fx-background-radius: 7;" />
            <HBox alignment="CENTER_LEFT" spacing="4">
                <Label fx:id="lblSalirPregunta" text="¿Deseas cerrar la aplicación?" style="-fx-font-size: 12px; -fx-text-fill: #69716d;" />
                <Hyperlink fx:id="linkSalir" text="Salir" onAction="#salir" style="-fx-font-size: 12px;" />
            </HBox>
            <padding><Insets top="0" right="0" bottom="0" left="0" /></padding>
        </VBox>
    </HBox>
</StackPane>
