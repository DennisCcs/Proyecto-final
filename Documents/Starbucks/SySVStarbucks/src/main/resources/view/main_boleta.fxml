<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.sysvstarbucks.controller.BoletaController"
      spacing="0">
    <ToolBar>
        <Label text="Boleta de venta" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnImprimir" text="Imprimir" onAction="#onImprimir"
                style="-fx-background-color: #52645d; -fx-text-fill: white; -fx-padding: 7 14; -fx-cursor: hand;" />
        <Button fx:id="btnExportarPdf" text="Guardar PDF" onAction="#onExportarPdf"
                style="-fx-background-color: #00704a; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 7 14; -fx-cursor: hand;" />
    </ToolBar>
    <ScrollPane fx:id="scrollVisor" fitToWidth="true" pannable="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: #e0e4e1;" />
</VBox>
